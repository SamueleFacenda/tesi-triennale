# latexmk build dir (when run with -outdir=build, as the Nix package does)
build/

# LaTeX intermediates (when latexmk is run directly in this folder)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.xmpi
*.pdf

# keep source images/PDFs under version control
!images/**/*.pdf

# i grafici generati da `kbench thesis` finiscono in images/plots/ e vanno versionati:
# `nix build .#thesis` vede solo i file tracciati da git.
